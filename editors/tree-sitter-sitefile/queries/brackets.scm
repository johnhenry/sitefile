; Bracket pairs (Zed's brackets.scm format).
(substitution "${" @open "}" @close)
(template_substitution "${" @open "}" @close)
(template_each "${" @open "}" @close)
(template_if "${" @open "}" @close)
(template_else "${" @open "}" @close)
(template_end "${" @open "}" @close)
(string "\"" @open "\"" @close)
