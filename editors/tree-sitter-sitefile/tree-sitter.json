{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sitefile",
      "camelcase": "Sitefile",
      "title": "Sitefile",
      "scope": "source.sitefile",
      "path": ".",
      "file-types": ["Sitefile", "sitefile"],
      "injection-regex": "^sitefile$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Sitefile grammar for tree-sitter",
    "authors": [{ "name": "John Henry" }],
    "links": { "repository": "https://github.com/johnhenry/sitefile" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
