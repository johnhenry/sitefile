{
  "name": "sitefile",
  "displayName": "Sitefile",
  "description": "Syntax highlighting and language server support for sitefile, the Docker-inspired static site builder",
  "version": "0.2.0",
  "publisher": "johnhenry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/sitefile.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sitefile",
    "static site",
    "dockerfile",
    "textmate",
    "lsp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sitefile"
  ],
  "scripts": {
    "build:grammar": "node scripts/build-grammar.mjs",
    "typecheck": "tsc -p .",
    "build": "npm run typecheck && node scripts/build-extension.mjs",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test test/",
    "package": "vsce package --skip-license",
    "preview": "node test/preview.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "sitefile.restartServer",
        "title": "Restart Language Server",
        "category": "Sitefile"
      }
    ],
    "configuration": {
      "title": "Sitefile",
      "properties": {
        "sitefile.server.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start the Sitefile language server (`sitefile lsp`) for Sitefiles. Highlighting works without it."
        },
        "sitefile.server.path": {
          "type": "string",
          "default": "sitefile",
          "scope": "machine-overridable",
          "markdownDescription": "The `sitefile` Rust binary: a command name looked up on `PATH`, an absolute path, or a path relative to the first workspace folder (`~` expands to the home directory). Install it with `cargo install --path rust` from a clone of the repository."
        },
        "sitefile.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "scope": "machine-overridable",
          "description": "Arguments passed to the server binary."
        },
        "sitefile.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server to the \"Sitefile Language Server\" output channel."
        }
      }
    },
    "languages": [
      {
        "id": "sitefile",
        "aliases": [
          "Sitefile",
          "sitefile"
        ],
        "filenames": [
          "Sitefile"
        ],
        "extensions": [
          ".sitefile"
        ],
        "filenamePatterns": [
          "Sitefile.*",
          "*.Sitefile"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sitefile",
        "scopeName": "source.sitefile",
        "path": "./syntaxes/sitefile.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.xml": "xml"
        }
      },
      {
        "scopeName": "sitefile.template.injection",
        "path": "./syntaxes/sitefile-template.injection.tmLanguage.json",
        "injectTo": [
          "source.sitefile"
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
