# Responsive images with the first-party image plugin (plugins/image, a
# WebAssembly module: it needs no --allow-plugin and can't touch files, the
# network or the clock). Results are cached by content digest, so an
# unchanged photo is not decoded again on the next build.
FROM scratch
PLUGIN image FROM ./plugins/image.wasm INTEGRITY sha256:9dc3d952f49be96e36bd7153701daf4d557aaf8079ac70cce5ba3eef981d86db

# A directory source runs the plugin once per file, in path order (drop more
# photos into ./photos/ and they are processed too). --include/--exclude pick
# the files with .sitefileignore patterns.
#
# Every JPEG in three widths, plus /img/<name>.json (paths, widths, heights, srcset).
TRANSFORM --include=*.jpg ./photos/ WITH image TO /img/ OPTIONS widths=400,800,1200 format=jpeg quality=80
# Every PNG (transparent graphics) at 1x and 2x, as lossless WebP with a PNG fallback.
TRANSFORM --include=*.png ./photos/ WITH image TO /img/ OPTIONS widths=64,128 format=webp,png
# A thumbnail of every file: '*.png' means one file per input, named after it
# (/img/thumbs/sky.png, /img/thumbs/badge.png); the extension picks the format.
TRANSFORM ./photos/ WITH image TO /img/thumbs/*.png OPTIONS widths=160

RENDER --escape=html ./templates/index.html TO /index.html
EXPORT /
