# A blog from Markdown posts with frontmatter.
#
#   posts/2026-01-05-hello-world.md  ->  /posts/hello-world/index.html
#
# Each post's frontmatter (title, description, tags, ...) is available to the
# templates, alongside slug, date, content (rendered HTML) and excerpt.
FROM scratch
ARG SITE_TITLE = "Field Notes"
ARG SITE_URL = "https://blog.example.com"
# Posts with `draft: true` are left out; preview them with --build-arg DRAFTS=true.
ARG DRAFTS: boolean = false
ARG PER_PAGE: number = 2

# Newest first, for the index, every post page and the feed; post.schema.yaml checks each post's frontmatter.
IMPORT posts FROM ./posts AS markdown SORT BY date DESC SCHEMA ./post.schema.yaml DRAFTS ${DRAFTS}

# Markup every page shares. An html fragment is a template evaluated where a
# RENDER uses it (${site_header}), so the values inside it are escaped by that
# RENDER's --escape=html while the markup itself is kept.
LET feed_link: html = <link rel="alternate" type="application/atom+xml" title="${SITE_TITLE}" href="/feed.xml">
LET site_header: html = <header><a class="site" href="/">${SITE_TITLE}</a></header>
LET post_list: html <<HTML
<nav>
      <h2>All posts</h2>
      <ul>
        ${#each posts as other}
        <li><a href="/posts/${other.slug}/">${other.title}</a></li>
        ${/each}
      </ul>
    </nav>
HTML

COPY ./public/ /
# The index, PER_PAGE posts a page: /index.html, then /page/2/index.html, ...
RENDER --escape=html ./templates/index.html TO /page/${page.number}/index.html FOR page IN posts PAGE ${PER_PAGE} FIRST /index.html
RENDER --escape=html ./templates/post.html TO /posts/${post.slug}/index.html FOR post IN posts
# One page per tag: /tags/sitefile/index.html lists the posts tagged sitefile.
RENDER --escape=html ./templates/tag.html TO /tags/${tag.key}/index.html FOR tag IN posts BY tags

# An Atom feed of the posts (newest first, as imported), and a sitemap of
# every page rendered so far. Both write absolute URLs under SITE_URL.
FEED posts BASE ${SITE_URL} LINK /posts/${item.slug}/index.html TITLE ${SITE_TITLE}
SITEMAP BASE ${SITE_URL}

# The stylesheet gets a content-hashed name (style.<hash>.css) that can be
# cached forever; every page's <link> is rewritten to it.
FINGERPRINT /style.css MANIFEST /asset-manifest.json

# Fail the build if a page links to a file that isn't there.
CHECKLINKS

# Old URLs and response headers, for hosts that read _redirects / _headers
# (Netlify, Cloudflare Pages; `sitefile serve` honours them too).
REDIRECT /feed /feed.xml
REDIRECT /posts/hello/* /posts/hello-world/:splat STATUS 302
HEADER /*.css Cache-Control: public, max-age=3600
HEADER /* X-Frame-Options: DENY
EXPORT /
