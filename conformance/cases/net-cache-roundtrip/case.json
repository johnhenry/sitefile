{
  "network": true,
  "steps": [
    ["build", "${CTX}", "-o", "${OUT}/first", "--allow-plugins", "--no-lockfile", "--cache-to", "${REGISTRY}/conf/cache-${IMPL}:1"],
    ["build", "${CTX}", "-o", "${OUT}/again", "--allow-plugins", "--no-lockfile", "--cache-to", "${REGISTRY}/conf/cache-${IMPL}:1"],
    {
      "args": ["build", "${CTX}", "-o", "${OUT}/second", "--allow-plugins", "--no-lockfile", "--cache-from", "${REGISTRY}/conf/cache-${IMPL}:1", "--cache-to", "${REGISTRY}/conf/cache-${IMPL}-copy:1"],
      "env": { "SITEFILE_HOME": "${TMP}/home2" }
    }
  ],
  "outputs": [["first", "tree"], ["second", "tree"]],
  "manifests": ["conf/cache-${IMPL}:1", "conf/cache-${IMPL}-copy:1"]
}
