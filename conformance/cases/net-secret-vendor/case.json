{
  "network": true,
  "steps": [
    {
      "args": [
        "vendor",
        "${CTX}",
        "--allow-private-network",
        "--secret",
        "id=key,env=API_TOKEN",
        "--secret",
        "id=tok,env=API_TOKEN"
      ],
      "env": {
        "API_TOKEN": "conformance-secret-7c1e"
      }
    },
    [
      "build",
      "${CTX}",
      "-o",
      "${OUT}/dist",
      "--frozen-lockfile"
    ]
  ],
  "outputs": [
    [
      "dist",
      "tree"
    ],
    [
      "ctx:vendor/sitefile",
      "tree"
    ]
  ],
  "stdout": true,
  "lock": true
}
