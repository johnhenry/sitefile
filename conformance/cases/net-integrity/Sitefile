# Every remote import pinned with INTEGRITY.
FROM scratch
IMPORT data FROM ${HTTPS}/data.json AS json INTEGRITY sha256:ce488399c576d775b6c36a355b949a2da5992646f53e0e4e574618dc19648aaa
IMPORT css FROM ${HTTPS}/style.css INTEGRITY sha256:3f876ff1240fb2b6e442980f352b6ca1f70e0b8cb0de7b9370d6a1b89e4f1c9c
IMPORT ver FROM ${HTTPS}/version.txt AS text INTEGRITY sha256:b03d44cd60d71de68a4aca7808c6f768802f6d6c414430ff8ccea10c1aa57b4c
COPY css: /style.css
RENDER --escape=html <<HTML TO /index.html
<h1>${data.title}</h1>
<p>${data.items.0.name}=${data.items.0.n}, ${data.items.1.name}=${data.items.1.n}</p>
<p>${ver}</p>
HTML
EXPORT /
