{
  "network": true,
  "steps": [
    [
      "build",
      "${CTX}",
      "-o",
      "${OUT}/site.oci.tar",
      "--label",
      "org.example.team=web"
    ],
    [
      "build",
      "${CTX}",
      "-o",
      "${OUT}/again.oci.tar",
      "--label",
      "org.example.team=web",
      "--frozen-lockfile"
    ]
  ],
  "outputs": [
    [
      "site.oci.tar",
      "oci"
    ],
    [
      "again.oci.tar",
      "oci"
    ]
  ],
  "lock": true
}
