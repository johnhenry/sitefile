{
  "command": "serve",
  "requests": [
    { "target": "/", "expect": { "status": 200, "interim": [103], "headers": { "last-modified": true, "link": "</a.css>; rel=preload; as=style, <https://cdn.example>; rel=preconnect" } } },
    { "method": "HEAD", "target": "/", "expect": { "status": 200, "interim": [] } },
    { "target": "/", "version": "1.0", "expect": { "status": 200, "interim": [] } },
    { "target": "/a.css", "expect": { "status": 200, "interim": [], "headers": { "last-modified": true } } },
    { "target": "/plain.html", "expect": { "status": 200, "interim": [103], "headers": { "link": "<https://cdn.example>; rel=preconnect, </a.css>; rel=stylesheet" } } },
    { "target": "/missing", "expect": { "status": 404, "interim": [], "headers": { "last-modified": null } } },
    { "target": "/a.css", "headers": { "if-modified-since": "Sun, 01 Jan 2090 00:00:00 GMT" }, "expect": { "status": 304, "headers": { "last-modified": true }, "body": "" } },
    { "target": "/a.css", "headers": { "if-modified-since": "Thu, 01 Jan 1970 00:00:00 GMT" }, "expect": { "status": 200, "body": "a{}\n" } },
    { "target": "/a.css", "headers": { "if-modified-since": "Sunday, 01-Jan-90 00:00:00 GMT" }, "expect": { "status": 200 } },
    { "target": "/a.css", "headers": { "if-modified-since": "Mon, 01 Jan 2090 00:00:00 GMT" }, "expect": { "status": 200 } },
    { "target": "/a.css", "headers": { "if-modified-since": "Sun, 01 Jan 2090 00:00:00 GMT", "if-none-match": "\"nope\"" }, "expect": { "status": 200 } },
    { "target": "/a.css", "headers": { "if-modified-since": "Sun, 01 Jan 2090 00:00:00 GMT", "range": "bytes=0-0" }, "expect": { "status": 304 } },
    { "target": "/a.css", "headers": { "range": "bytes=0-0" }, "expect": { "status": 206, "headers": { "last-modified": true } } }
  ]
}
