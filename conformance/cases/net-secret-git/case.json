{
  "network": true,
  "steps": [
    {
      "args": [
        "build",
        "${CTX}",
        "-o",
        "${OUT}/dist",
        "--allow-private-network",
        "--secret",
        "id=tok,env=API_TOKEN"
      ],
      "env": {
        "API_TOKEN": "conformance-secret-7c1e"
      }
    },
    {
      "args": [
        "outdated",
        "${CTX}",
        "--allow-private-network",
        "--secret",
        "id=tok,env=API_TOKEN"
      ],
      "env": {
        "API_TOKEN": "conformance-secret-7c1e"
      }
    }
  ],
  "outputs": [
    [
      "dist",
      "tree"
    ]
  ],
  "stdout": true,
  "lock": true
}
