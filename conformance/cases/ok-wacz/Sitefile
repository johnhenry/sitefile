# EXPORT ... AS wacz: a WACZ package (WARC, CDXJ index, pages, datapackage), compared byte for byte.
FROM scratch
COPY <<HTML /index.html
<!doctype html><title>archived</title><p>home</p>
HTML
COPY <<HTML /docs/index.html
<title>Docs</title><p>docs</p>
HTML
COPY <<CSS "/css/site style.css"
body { color: #333; }
CSS
COPY <<H /_headers
/css/*
  Cache-Control: max-age=60
/*
  X-Frame-Options: DENY
H
EXPORT / AS wacz BASE https://www.example.org/
