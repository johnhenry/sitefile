{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "redirects": [
      { "source": "/old", "destination": "/new", "type": 301 },
      { "source": "/blog/**", "destination": "https://blog.example.com", "type": 302 },
      { "regex": "^/u/(\\d+)$", "destination": "/users/:1" }
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=604800" }] }
    ]
  }
}
