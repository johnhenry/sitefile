{
  "command": "serve",
  "args": [
    "--html-handling",
    "force-slash"
  ],
  "requests": [
    {
      "target": "/about",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/about/"
        }
      }
    },
    {
      "target": "/about/",
      "expect": {
        "status": 200,
        "body": "about\n"
      }
    },
    {
      "target": "/about.html",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/about/"
        }
      }
    },
    {
      "target": "/docs",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/docs/"
        }
      }
    },
    {
      "target": "/docs/index.html",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/docs/"
        }
      }
    },
    {
      "target": "/?q=1",
      "expect": {
        "status": 200,
        "body": "home\n"
      }
    }
  ]
}
