{
  "command": "serve",
  "args": ["--max-age", "31536000", "--immutable"],
  "requests": [
    { "target": "/app.css", "expect": { "status": 200, "headers": { "cache-control": "public, max-age=31536000, immutable" } } },
    { "target": "/app.css", "headers": { "if-none-match": "\"bb4263d9ed62ec8064343107746123e98499b5e2ba5beab54aff959fcc77e372\"" }, "expect": { "status": 304, "headers": { "cache-control": "public, max-age=31536000, immutable" } } },
    { "target": "/app.css", "headers": { "range": "bytes=0-0" }, "expect": { "status": 206, "headers": { "cache-control": "public, max-age=31536000, immutable" } } },
    { "target": "/", "expect": { "status": 200, "headers": { "cache-control": "no-cache" } } },
    { "target": "/keep.txt", "expect": { "status": 200, "headers": { "cache-control": "no-store" } } },
    { "target": "/missing", "expect": { "status": 404, "headers": { "cache-control": "no-cache" } } }
  ]
}
