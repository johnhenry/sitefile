{
  "command": "serve",
  "args": [
    "--html-handling",
    "none"
  ],
  "requests": [
    {
      "target": "/about",
      "expect": {
        "status": 404
      }
    },
    {
      "target": "/about.html",
      "expect": {
        "status": 200
      }
    },
    {
      "target": "/docs",
      "expect": {
        "status": 404
      }
    },
    {
      "target": "/docs/",
      "expect": {
        "status": 200
      }
    },
    {
      "target": "/old",
      "expect": {
        "status": 301,
        "headers": {
          "location": "/about"
        }
      }
    }
  ]
}
