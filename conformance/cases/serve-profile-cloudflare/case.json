{
  "command": "serve",
  "args": [
    "--host-profile",
    "cloudflare"
  ],
  "requests": [
    {
      "target": "/about",
      "expect": {
        "status": 200
      }
    },
    {
      "target": "/about.html",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/about"
        }
      }
    },
    {
      "target": "/about/",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/about"
        }
      }
    },
    {
      "target": "/docs",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/docs/"
        }
      }
    },
    {
      "target": "/docs/index.html",
      "expect": {
        "status": 307,
        "headers": {
          "location": "/docs/"
        }
      }
    },
    {
      "target": "/old",
      "expect": {
        "status": 301,
        "headers": {
          "location": "/about"
        }
      }
    },
    {
      "target": "/nope",
      "expect": {
        "status": 200,
        "body": "home\n"
      }
    }
  ]
}
