{
  "network": true,
  "steps": [
    [
      "build",
      "${CTX}",
      "-o",
      "${OUT}/dist",
      "--allow-private-network"
    ],
    [
      "build",
      "${CTX}",
      "-o",
      "${OUT}/again",
      "--allow-private-network",
      "--frozen-lockfile"
    ]
  ],
  "outputs": [
    [
      "dist",
      "tree"
    ],
    [
      "again",
      "tree"
    ]
  ],
  "lock": true
}
